{
  "name": "anvilwiki",
  "version": "2.39.0",
  "type": "module",
  "description": "Open-source game wiki site template. Astro + Cloudflare Pages. Free, fast, beginner-friendly.",
  "license": "MIT",
  "homepage": "https://anvil.wiki",
  "repository": {
    "type": "git",
    "url": "https://github.com/PNGTRID/AnvilWiki.git"
  },
  "bugs": {
    "url": "https://github.com/PNGTRID/AnvilWiki/issues"
  },
  "keywords": [
    "astro",
    "cloudflare-pages",
    "game-wiki",
    "wiki-template",
    "seo",
    "i18n",
    "mdx",
    "tailwindcss",
    "static-site",
    "open-source",
    "giscus",
    "lighthouse-100"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/transpile-pagefind.mjs && tsx scripts/write-indexnow-key.ts",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-apply-template.mjs",
    "check-sitemap": "tsx scripts/check-sitemap.ts",
    "check-config": "tsx scripts/check-config.ts",
    "new-post": "tsx scripts/new-post.ts",
    "bulk-new-posts": "tsx scripts/bulk-new-posts.ts",
    "sync-codes": "tsx scripts/sync-codes.ts",
    "gen-covers": "tsx scripts/gen-covers.ts",
    "gen-assets": "tsx scripts/gen-assets.ts",
    "init-indexnow-key": "tsx scripts/init-indexnow-key.ts",
    "submit-indexnow": "tsx scripts/submit-indexnow.ts",
    "template-audit": "tsx scripts/template-audit.ts",
    "new-locale": "tsx scripts/new-locale.ts",
    "apply-template": "tsx scripts/apply-template.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "check-links": "tsx scripts/check-links.ts",
    "check-versions": "tsx scripts/check-versions.ts",
    "check-content": "tsx scripts/check-content.ts",
    "refresh-audit": "tsx scripts/refresh-audit.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.10",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/tailwind": "^5.1.5",
    "@iconify-json/lucide": "^1.2.153",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "private": true
}
