---
/**
 * Site header — logo, primary nav, inline search field, theme toggle,
 * language switcher. Mobile menu uses native <details> (zero JS).
 *
 * Visual language (ported from the magus-circle restyle): parchment bar,
 * serif wordmark, and full-height nav links highlighted by a 2px brand
 * underline instead of a pill background.
 */
import { Icon } from 'astro-icon/components';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import { type Locale, defaultLocale, locales, LOCALE_LABELS } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl, localizePath } from '~/lib/url';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchButton from './SearchButton.astro';
import { landingLink, landingLinkEnabled, zhLandingLink } from '~/config/project';

interface Props {
  locale: Locale;
  currentPath: string;
  /**
   * Locales the current page exists in (optional). Pages that DON'T fall
   * back to English (tag pages) pass their real coverage so the language
   * switcher never links to a 404.
   */
  availableLocales?: readonly Locale[];
}
const { locale, currentPath, availableLocales } = Astro.props;
const ui = getUi(locale);
const nav: Record<string, string> = ui.nav as Record<string, string>;

const headerLocales = availableLocales ?? locales;

// Build the strip regex from `locales` — a hardcoded "en|ja" list would
// silently break for forks that add languages (same rationale as BaseLayout).
const localePrefixRe = new RegExp(`^/(${locales.filter((l) => l !== defaultLocale).join('|')})(?=/|$)`);

const samePagePathFor = (loc: Locale) => {
  // Strip existing locale prefix, then prepend the new one. Homepages go
  // through homeUrl — in demo builds the English home lives at /demo/ and
  // the root `/` is a redirect gateway, so switching FROM /demo/ must map to
  // the locale's real homepage (homeUrl('ja') = '/ja/'), never a localized
  // '/ja/demo/' (no such route). In forks landingLinkEnabled is false, so
  // isHome only matches the plain '/' and the result stays byte-equal to the
  // old localizePath('/', loc).
  const stripped = currentPath.replace(localePrefixRe, '') || '/';
  const isHome = stripped === '/' || (landingLinkEnabled && stripped === '/demo/');
  return isHome ? homeUrl(loc) : localizePath(stripped, loc);
};
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 lg:gap-5">
    {/* Logo — homeUrl keeps demo builds pointing at /demo/ (the root is the
        storefront gateway); forks get '/' exactly as before. */}
    <a
      href={homeUrl(locale)}
      class="flex shrink-0 items-center gap-2.5 font-display text-lg font-bold text-foreground"
      aria-label={site.name}
    >
      <img src="/logo.svg" width="32" height="32" alt="" class="h-8 w-8 shrink-0" />
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    {/* Desktop nav — full-height links with a brand underline on the active item. */}
    <nav class="hidden min-w-0 items-center gap-1 overflow-x-auto xl:flex" aria-label={nav.menu}>
      {
        NAVIGATION_CONFIG.map((item) => {
          const path = localizePath(item.path, locale);
          // `path` ends with "/" (trailingSlash:'always') — appending again
          // would produce "//" and silently break child-page highlighting.
          const activePrefix = path.endsWith('/') ? path : path + '/';
          const isActive = currentPath === path || currentPath.startsWith(activePrefix);
          return (
            <a
              href={path}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'shrink-0 whitespace-nowrap border-b-2 px-2.5 py-5 text-sm font-medium transition-colors',
                isActive
                  ? 'border-nav text-nav'
                  : 'border-transparent text-muted-foreground hover:border-nav/40 hover:text-foreground',
              ]}
            >
              {nav[item.key] ?? item.key}
            </a>
          );
        })
      }
    </nav>

    {/* One shared dialog; keep a visible search field even on narrow screens. */}
    <div class="header-search ml-auto flex min-w-0 flex-1 sm:max-w-xs xl:max-w-[15rem]">
      <SearchButton locale={locale} variant="field" />
    </div>

    {/* Right actions */}
    <div class="flex shrink-0 items-center gap-1">
      {landingLinkEnabled && (
        <a
          href={landingLink.href}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground transition hover:bg-muted hover:text-nav"
          aria-label={landingLink.ariaLabel}
          title={landingLink.ariaLabel}
        >
          <Icon name="lucide:hammer" class="h-5 w-5" />
        </a>
      )}
      <ThemeToggle />
      <div class="hidden sm:block">
        <LanguageSwitcher
          locale={locale}
          pathFor={samePagePathFor}
          availableLocales={availableLocales}
        />
      </div>

      {/* Mobile menu */}
      <details class="relative xl:hidden">
        <summary
          aria-label={nav.menu}
          class="inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-foreground transition hover:bg-muted [&::-webkit-details-marker]:hidden"
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <div class="absolute right-0 mt-3 max-h-[calc(100dvh-5rem)] w-64 max-w-[calc(100vw-2rem)] overflow-y-auto rounded-md border bg-card shadow-lg">
          {/* Prominent search entry — mobile readers don't know Cmd+K */}
          <button
            type="button"
            data-open-search
            class="flex w-full items-center gap-2 border-b border-border px-3 py-2.5 text-sm font-medium text-nav transition hover:bg-muted"
          >
            <Icon name="lucide:search" class="h-4 w-4" />
            <span>{nav.search ?? 'Search'}</span>
          </button>
          {
            NAVIGATION_CONFIG.map((item) => (
              <a
                href={localizePath(item.path, locale)}
                aria-current={
                  currentPath === localizePath(item.path, locale) ||
                  currentPath.startsWith(localizePath(item.path, locale))
                    ? 'page'
                    : undefined
                }
                class="block border-l-2 border-transparent px-3 py-2.5 text-sm transition hover:bg-muted aria-[current=page]:border-nav aria-[current=page]:bg-muted aria-[current=page]:text-nav"
              >
                {nav[item.key] ?? item.key}
              </a>
            ))
          }
          {/* Language switcher for mobile — flat list, not nested dropdown */}
          <div class="border-t border-border pt-1">
            <div class="flex items-center gap-1 px-3 pb-1 text-xs text-muted-foreground">
              <Icon name="lucide:globe" class="h-3 w-3" />
              <span>{nav.language ?? 'Language'}</span>
            </div>
            {
              headerLocales.map((loc) => (
                <a
                  href={samePagePathFor(loc)}
                  class:list={[
                    'block px-3 py-2 text-sm transition hover:bg-muted',
                    loc === locale && 'font-semibold text-nav',
                  ]}
                >
                  {LOCALE_LABELS[loc]}
                </a>
              ))
            }
            {landingLinkEnabled && (
              <a
                href={zhLandingLink.href}
                class="block border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
              >
                {zhLandingLink.label}
              </a>
            )}
          </div>
          {landingLinkEnabled && (
            <a
              href={landingLink.href}
              class="mt-1 flex items-center gap-2 border-t border-border px-3 py-2 text-sm text-muted-foreground transition hover:bg-muted hover:text-nav"
            >
              <Icon name="lucide:hammer" class="h-4 w-4" />
              <span>{landingLink.label}</span>
            </a>
          )}
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .header-search :global(#search-trigger) {
    width: 100%;
    min-width: 0;
    height: 2.5rem;
    justify-content: flex-start;
    padding-inline: 0.75rem;
    background: hsl(var(--card));
    border-color: hsl(var(--brand) / 0.4);
  }

  .header-search :global(#search-trigger > span) {
    display: inline;
  }
</style>
