---
/**
 * List page — shows all articles in a category for a locale.
 *
 * Behavior (PRD §9.3): does NOT fall back to English. If the locale has
 * no articles in this category, the empty state is shown.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import ArticleCover from '~/components/article/ArticleCover.astro';
import DealsOverview from '~/components/article/DealsOverview.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getEntriesByCategory, parseEntryId } from '~/lib/content';
import { toDealMerchants } from '~/lib/content-utils';
import { itemListJsonLd, pageTitle, simpleBreadcrumbJsonLd } from '~/lib/seo';
import { detailPath, homeUrl, listPath, localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
  category: string;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, category, alternates = [] } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared;
const overview = (
  ui.overview as Record<string, { overviewTitle: string; overviewDescription: string }>
)[category];
const navItem = NAVIGATION_CONFIG.find((n) => n.key === category);

const title = overview?.overviewTitle ?? nav[category] ?? category;
// Localized default (locale JSON shared.defaultListDescription) — a hardcoded
// English sentence here would leak into every locale the moment a fork adds
// a 5th category without an overview entry. `|| title` (not ??) so an empty
// locale string genuinely falls back to the bare title.
const description =
  overview?.overviewDescription ??
  (String(shared.defaultListDescription ?? '').replace('{title}', title) || title);

const entries = await getEntriesByCategory(category, locale);

// Sibling category chips with live counts — only categories that actually
// have entries in this locale (matches the noindex-empty-category rule).
const categoryLinks = (await Promise.all(
  NAVIGATION_CONFIG.map(async (item) => ({
    ...item,
    count:
      item.key === category
        ? entries.length
        : (await getEntriesByCategory(item.key, locale)).length,
  })),
)).filter((item) => item.count > 0);

// Coupon-hub presentation variant: the codes list becomes a merchant-grouped
// deals board instead of article cards. Build-time signal from site.ts —
// game-wiki forks never carry the line, so this branch is dead code there.
const dealView = site.siteType === 'coupon-hub' && category === 'codes' && entries.length > 0;
const merchants = toDealMerchants(entries).map((m) => ({
  title: m.title,
  href: detailPath(category, m.slug, locale),
  codes: m.codes,
}));

const jsonLd = [
  // Empty ItemList (itemListElement: []) is invalid structured data — only
  // inject when the list actually has entries (breadcrumb stays either way).
  ...(entries.length > 0
    ? [
        itemListJsonLd({
          category,
          categoryLabel: title,
          locale,
          items: entries.map((e) => {
            const slug = parseEntryId(e.id)?.slug ?? '';
            return { title: e.data.title, slug };
          }),
        }),
      ]
    : []),
  simpleBreadcrumbJsonLd({
    pageLabel: title,
    path: listPath(category, locale),
    locale,
    homeLabel: nav.home,
  }),
];
---

<!-- An empty list is a ~100-word thin-content page (NMS /starships was indexed
     as one). noindex keeps it out of Google until real articles exist; the
     sitemap filter excludes the same paths (astro.config.ts). -->
<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={entries.length === 0}
>
  <div class="space-y-8">
    <header class="border-b border-border pb-7">
      <nav class="text-sm text-muted-foreground" aria-label={shared.breadcrumbAria ?? 'Breadcrumb'}>
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-foreground" aria-current="page">{nav[category] ?? title}</span>
      </nav>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
        <div class="min-w-0 max-w-3xl">
          <div class="mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-nav">
            {navItem && <Icon name={navItem.icon} class="h-4 w-4" />}
            <span>{nav[category] ?? title}</span>
          </div>
          <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl md:text-5xl">{title}</h1>
          <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">{description}</p>
        </div>
        <p class="flex shrink-0 items-baseline gap-2 border-l border-nav/50 pl-4 text-sm text-muted-foreground">
          <span class="font-display text-3xl text-foreground">{entries.length}</span>
          {shared.articlesCount}
        </p>
      </div>
    </header>

    {
      entries.length > 0 && (
        <nav class="flex flex-wrap items-center gap-2" aria-label={shared.browseAll}>
          {categoryLinks.map((item) => (
            <a
              href={localizePath(item.path, locale)}
              aria-current={item.key === category ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm transition-colors',
                item.key === category
                  ? 'border-nav/50 bg-nav/10 font-semibold text-nav'
                  : 'border-border bg-card text-muted-foreground hover:border-nav/50 hover:text-foreground',
              ]}
            >
              {nav[item.key] ?? item.key}
              <span class="text-xs tabular-nums text-muted-foreground">{item.count}</span>
            </a>
          ))}
          <a href={localizePath('/recent/', locale)} class="inline-flex items-center gap-2 px-3 py-2 text-sm text-muted-foreground hover:text-nav">
            <Icon name="lucide:clock" class="h-4 w-4" />
            {shared.recentTitle}
          </a>
        </nav>
      )
    }

    {
      entries.length === 0 ? (
        <div class="rounded-lg border border-dashed bg-card p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : dealView ? (
        <DealsOverview
          merchants={merchants}
          labels={shared.codesTable ?? {}}
          copiedText={shared.copied}
        />
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => {
            const slug = parseEntryId(entry.id)?.slug ?? '';
            const updated = entry.data.lastModified ?? entry.data.date;
            return (
              <a href={detailPath(category, slug, locale)} class="card group flex min-w-0 flex-col overflow-hidden">
                {entry.data.image && (
                  <ArticleCover src={entry.data.image} class="aspect-video w-full border-b border-border object-cover" />
                )}
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <p class="mb-3 text-xs font-medium uppercase tracking-wider text-nav">
                    {nav[category] ?? category}
                  </p>
                  <h2 class="text-xl font-semibold leading-snug transition-colors group-hover:text-nav">{entry.data.title}</h2>
                  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">
                    {entry.data.description}
                  </p>
                  <div class="mt-auto flex items-end justify-between gap-3 pt-6">
                    <p class="text-xs leading-relaxed text-muted-foreground">
                      <span class="block">{entry.data.lastModified ? shared.lastUpdated : shared.publishedOn}</span>
                      <time datetime={updated.toISOString()}>{updated.toLocaleDateString(locale, { timeZone: 'UTC' })}</time>
                    </p>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-nav">
                      {shared.open}
                      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</LocaleLayout>
