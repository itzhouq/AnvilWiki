---
/**
 * QuickStart — prominent icon-card grid of the 4 things a new player needs.
 *
 * Renders `home.start.cards` as large, clickable tiles (2×2 on desktop,
 * single column on mobile). Each card carries a bordered icon tile, a serif
 * title, one-line description, and a theme-colored "Open →" affordance —
 * the task-card pattern from the magus-circle restyle.
 *
 * Placed immediately after the Hero so first-time visitors see their
 * next step without scrolling past marketing copy.
 */
import { Icon } from 'astro-icon/components';
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';
import { getUi } from '~/i18n/ui';

interface StartCard {
  number: string;
  title: string;
  description: string;
  icon: string;
  href: string;
}

interface Props {
  locale: Locale;
  badge?: string;
  title?: string;
  cards?: StartCard[];
}
const { locale, badge = 'Start Here', title = 'Quick Start', cards = [] } = Astro.props;
const sharedStrings = getUi(locale).shared;
const open = sharedStrings.open ?? 'Open';
---
{cards.length > 0 && (
  <section class="border-t border-border py-10 md:py-12">
    <p class="eyebrow">{badge}</p>
    <p class="mt-2 font-display text-2xl font-semibold tracking-tight md:text-3xl">{title}</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {cards.map((card: StartCard) => (
        <a
          href={localizePath(card.href, locale)}
          class="task-card card group flex gap-4 p-5 sm:p-6"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm border border-nav/25 bg-nav/5 text-nav">
            <Icon name={card.icon} class="h-5 w-5" />
          </span>
          <div class="min-w-0">
            <h3 class="font-display text-lg font-semibold group-hover:text-nav">{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{card.description}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-nav">
              {open}
              <Icon
                name="lucide:arrow-right"
                class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1"
              />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  /* Card hover lifts into a faint brand wash instead of a shadow. */
  .task-card:hover {
    background: linear-gradient(125deg, hsl(var(--brand) / 0.06), hsl(var(--card)));
  }
  @media (prefers-reduced-motion: reduce) {
    .task-card :global(svg) {
      transition: none;
      transform: none;
    }
  }
</style>
