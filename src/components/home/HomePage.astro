---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs (strong visual anchor)
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   3. Recent Updates + Trending links (two columns)
 *   4. Explore       — 4 content modules with displayTypes
 *   5. ClosingCta    — bottom call-to-action
 *
 * Visual language ported from the magus-circle restyle: parchment surfaces,
 * serif display headings, eyebrow kickers, and divide-y list rows instead
 * of card grids for the update feed.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import DealsOverview from '~/components/article/DealsOverview.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi, type HomeUi } from '~/i18n/ui';
import { getEntriesByCategory, getRecentEntries, parseEntryId } from '~/lib/content';
import { toDealMerchants } from '~/lib/content-utils';
import { localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
// Typed straight from en.json (HomeUi) — no `as any`: a renamed key now
// fails typecheck instead of silently blanking the block (check-i18n only
// compares locale↔en, not component↔en; tests/home-ui.test.ts pins the
// access surface at the JSON level too).
const home = ui.home;
const shared = ui.shared;
const nav = ui.nav as Record<string, string>;

const recent = await getRecentEntries(locale, 6);

// Coupon-hub homepage strip: a compact live-deals board (3 merchants × 2
// active codes) aggregated from the codes category. Gated on the build-time
// siteType signal — game-wiki forks never carry the line, so this stays dead
// code there and the default output is byte-identical. Title/CTA reuse
// existing keys (overview.codes / shared.browseAll) — zero new i18n.
const couponDeals =
  site.siteType === 'coupon-hub'
    ? await (async () => {
        const entries = await getEntriesByCategory('codes', locale);
        const overview = ui.overview as Record<string, { overviewTitle?: string }> | undefined;
        return {
          title:
            overview?.codes?.overviewTitle ??
            (ui.nav as Record<string, string>).codes ??
            'Deals',
          merchants: toDealMerchants(entries)
            .slice(0, 3)
            .map((m) => ({ ...m, href: detailPath('codes', m.slug, locale) })),
        };
      })()
    : null;

// Per-field fallbacks: a locale JSON whose meta object exists but lacks
// title/description must not pass undefined into BaseLayout (title.includes
// crashes the build) — same spirit as the ?? defaults below.
const meta = {
  title: home.meta?.title ?? site.name,
  description: home.meta?.description ?? site.description,
};
// Section namespaces come from en.json verbatim (getUi deep-merges non-en
// locales over en), so every key is guaranteed present — no per-section
// `{ cards: [] }`-style fallbacks and no hardcoded English anywhere. A key
// missing from en.json itself is a build-time typecheck failure, not a
// blanked section at runtime.
const hero: HomeUi['hero'] = home.hero;
const updates: HomeUi['updates'] = home.updates;
const start: HomeUi['start'] = home.start;
const popular: HomeUi['popular'] = home.popular;
const explore: HomeUi['explore'] = home.explore;
const closingCta: HomeUi['closingCta'] = home.closingCta;

const formatDate = (date: Date) =>
  date.toLocaleDateString(locale, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Hero primary CTA: an optional internal href (home.hero.ctaPrimaryHref) wins
// so "Start reading" lands on a wiki page; absence falls back to the game's
// official link (external → new tab). Internal links never open a new tab.
const ctaPrimaryHref = hero.ctaPrimaryHref
  ? localizePath(hero.ctaPrimaryHref, locale)
  : site.social.official;
const ctaPrimaryExternal = !hero.ctaPrimaryHref;

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <section
    class="home-hero overflow-hidden rounded-lg border border-border"
    aria-labelledby="home-heading"
  >
    <div class:list={['grid', hero.image && 'lg:grid-cols-[1.05fr_1fr]']}>
      <div class="flex flex-col justify-center px-6 py-9 sm:px-10 sm:py-12 lg:py-16">
        <p class="eyebrow flex items-center gap-2">
          <span class="h-px w-7 bg-nav" aria-hidden="true"></span>{hero.badge}
        </p>
        <p class="mt-5 text-sm font-semibold tracking-wide text-muted-foreground">{site.name}</p>
        <h1
          id="home-heading"
          class="mt-3 max-w-xl font-display text-4xl font-semibold leading-[1.12] tracking-tight sm:text-5xl lg:text-[3.5rem]"
        >
          {hero.title}
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-muted-foreground">{hero.description}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          {
            hero.ctaPrimary && (
              <a
                href={ctaPrimaryHref}
                {...(ctaPrimaryExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="btn-primary gap-2"
              >
                {hero.ctaPrimary}
                <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
            )
          }
          {
            hero.ctaSecondary && (
              <a href={listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)} class="btn-outline">
                {hero.ctaSecondary}
              </a>
            )
          }
        </div>
      </div>
      {
        hero.image && (
          <figure class="hero-art relative min-h-[260px] overflow-hidden lg:min-h-[470px]">
            <img
              src={hero.image}
              alt={hero.imageAlt ?? ''}
              width="1920"
              height="1080"
              fetchpriority="high"
              loading="eager"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover"
            />
            {hero.imageCredit && (
              <figcaption class="absolute bottom-3 right-3 rounded-sm border border-border bg-card/95 px-2 py-1 text-[10px] text-muted-foreground">
                {hero.imageSource ? (
                  <a href={hero.imageSource} target="_blank" rel="noopener noreferrer" class="hover:text-foreground hover:underline">
                    {hero.imageCredit}
                  </a>
                ) : (
                  hero.imageCredit
                )}
              </figcaption>
            )}
          </figure>
        )
      }
    </div>
  </section>

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && (
    <VideoSection videoId={hero.videoId} title={`${site.game.name} ${shared.gameTrailer}`} />
  )}

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart
    locale={locale}
    badge={start.badge}
    title={start.title}
    cards={start.cards}
  />

  {/* ─────────────────── Coupon-hub live deals strip ───────────────────── */}
  {
    couponDeals && couponDeals.merchants.length > 0 && (
      <section class="section border-t border-border">
        <div class="flex items-baseline justify-between">
          <h2 class="text-2xl font-bold">{couponDeals.title}</h2>
          <a href={listPath('codes', locale)} class="text-sm text-foreground hover:text-nav hover:underline">
            {shared.browseAll}
          </a>
        </div>
        <div class="mt-4">
          <DealsOverview
            merchants={couponDeals.merchants}
            perMerchantLimit={2}
            labels={shared.codesTable ?? {}}
            copiedText={shared.copied}
          />
        </div>
      </section>
    )
  }

  {/* ───────────────────── Recent Updates + Most read ─────────────────── */}
  <section class="grid gap-8 border-t border-border py-10 md:py-12 lg:grid-cols-[1.6fr_1fr]">
    {/* Recent updates — divide-y list rows, 2/3 width on desktop. */}
    <div>
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">{updates.title}</h2>
        <a href={listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)} class="text-sm font-semibold text-nav hover:underline"
          >{shared.browseAll}</a
        >
      </div>
      <div class="mt-5 divide-y divide-border">
        {
          recent.length === 0 ? (
            <p class="py-5 text-sm text-muted-foreground">{shared.noArticles}</p>
          ) : (
            recent.map((entry) => {
              const parsed = parseEntryId(entry.id);
              if (!parsed) return null;
              const date = entry.data.lastModified ?? entry.data.date;
              return (
                <article class="py-5">
                  <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground">
                    <span class="font-semibold text-nav">{nav[parsed.category] ?? parsed.category}</span>
                    <time datetime={date.toISOString()}>{formatDate(date)}</time>
                  </div>
                  <h3 class="mt-2 text-lg font-semibold leading-snug">
                    <a class="hover:text-nav hover:underline" href={detailPath(parsed.category, parsed.slug, locale)}>
                      {entry.data.title}
                    </a>
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                    {entry.data.description}
                  </p>
                </article>
              );
            })
          )
        }
      </div>
    </div>

    {/* Most read — numbered sidebar list, 1/3 width on desktop. */}
    {trendingLinks.length > 0 && (
      <aside class="lg:border-l lg:border-border lg:pl-8">
        <p class="eyebrow">{popular.badge}</p>
        <h2 class="mt-2 font-display text-2xl font-semibold">{popular.title}</h2>
        <ol class="mt-4 divide-y divide-border">
          {trendingLinks.map((link: QuickLink, index: number) => {
            const href = trendingHref(link);
            const label = trendingLabel(link);
            return (
              <li>
                {href ? (
                  <a
                    href={href}
                    class="group flex items-center gap-3 py-3 text-sm hover:text-nav"
                  >
                    <span class="font-mono text-xs text-nav">{String(index + 1).padStart(2, '0')}</span>
                    <span class="flex-1">{label}</span>
                    <Icon name="lucide:chevron-right" class="h-4 w-4 text-muted-foreground group-hover:text-nav" />
                  </a>
                ) : (
                  <div class="flex items-center gap-3 py-3 text-sm">
                    <span class="font-mono text-xs text-nav">{String(index + 1).padStart(2, '0')}</span>
                    <span class="flex-1">{label}</span>
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </aside>
    )}
  </section>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="border-t border-border py-10 md:py-12">
        <h2 class="font-display text-2xl font-semibold md:text-3xl">{explore.title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{explore.description}</p>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="border-t border-border py-10 md:py-12">
        <div class="home-hero rounded-lg border border-border p-8 text-center md:p-12">
          <h2 class="font-display text-2xl font-semibold md:text-3xl">{closingCta.title}</h2>
          <p class="mx-auto mt-3 max-w-xl leading-relaxed text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              {closingCta.primary}
            </a>
            {closingCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                {closingCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>

<style>
  /* Brand-tinted reading surfaces: a faint radial glow from the top-left
     over the card color, used by the hero and closing CTA. */
  .home-hero {
    background:
      radial-gradient(ellipse at top left, hsl(var(--brand) / 0.09), transparent 65%),
      hsl(var(--card));
  }
  .hero-art {
    background: hsl(var(--muted));
  }
</style>
